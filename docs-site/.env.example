# OcuTrap docs-site environment variables. Copy to .env.local for local dev.
# All are optional — the site builds and runs with none of them set.

# --- AI ask (SITE-04) ---
# Anthropic API key. Without it, the "Ask OcuTrap AI" endpoint returns 503 and
# the UI shows the "AI answers aren't available" notice.
ANTHROPIC_API_KEY=

# Override the answer model (defaults to claude-haiku-4-5).
# ANSWER_MODEL=claude-haiku-4-5-20251001

# --- Analytics (SITE-07) ---
# PostHog client (publishable) token. A committed default points at the OcuTrap
# workspace; set this only to override it. Leave empty to disable analytics
# entirely (the site no-ops cleanly with no key).
NEXT_PUBLIC_POSTHOG_KEY=
